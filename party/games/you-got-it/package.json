{
  "name": "@open-party-lab/game-you-got-it",
  "version": "0.1.0",
  "description": "¿Le atinaste? Bien.: espectros, pistas y equipos. Puerto mexicano para Vision+.",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./manifest": { "types": "./dist/manifest.d.ts", "import": "./dist/manifest.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "import": "./dist/protocol.js" },
    "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" },
    "./host": { "types": "./dist/host/index.d.ts", "import": "./dist/host/index.js" },
    "./controller": { "types": "./dist/controller/index.d.ts", "import": "./dist/controller/index.js" }
  },
  "files": ["dist", "README.md", "public"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/simulation.mjs"
  },
  "peerDependencies": {
    "@open-party-lab/game-core": "0.1.0",
    "@open-party-lab/utils": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@open-party-lab/game-core": { "optional": true },
    "@open-party-lab/utils": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.7.3"
  }
}
