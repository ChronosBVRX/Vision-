# Copia este archivo como keystore.properties y ajusta storeFile.
# NUNCA subas a Git el keystore ni keystore.properties.
#
# La OTA usa la llave histórica de Vision+ para que las actualizaciones
# sigan instalándose encima de la app existente. publish_ota.ps1 valida
# la huella SHA-256 y aborta si no coincide.
storeFile=C:/Users/TU_USUARIO/.android/debug.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
