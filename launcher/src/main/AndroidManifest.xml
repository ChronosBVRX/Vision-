<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Auto-actualización del launcher (se instala como cualquier APK, sin tienda). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- El feed de Vision+ (permiso de firma: solo con la llave histórica). -->
    <uses-permission android:name="com.chronosbvrx.visionplus.permission.HOME_FEED" />
    <!-- Precalentamiento opcional del motor de Vision+ (mismo candado de firma). -->
    <uses-permission android:name="com.chronosbvrx.visionplus.permission.ENGINE_PREWARM" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Ver las apps instaladas sin pedir QUERY_ALL_PACKAGES: solo las que se pueden lanzar. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.chronosbvrx.visionplus" />
    </queries>

    <application
        android:name=".HomeApp"
        android:allowBackup="false"
        android:banner="@drawable/ic_home_banner"
        android:icon="@drawable/ic_home_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VisionHome"
        android:largeHeap="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.VisionHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Instalador del propio launcher (la descarga vive en el cache de la app). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/home_update_paths" />
        </provider>
    </application>
</manifest>
