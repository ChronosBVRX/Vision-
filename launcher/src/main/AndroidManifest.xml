<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Auto-actualización del launcher (se instala como cualquier APK, sin tienda). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- «Cerrar app» del menú largo: detiene apps que quedaron en segundo plano. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Desinstalar desde el launcher: el instalador de Android exige este permiso al que
         lanza ACTION_DELETE (verificado en Android 16: sin él la pantalla abre y se cierra). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- El feed de Vision+ (permiso de firma: solo con la llave histórica). -->
    <uses-permission android:name="com.chronosbvrx.visionplus.permission.HOME_FEED" />
    <!-- Precalentamiento opcional del motor de Vision+ (mismo candado de firma). -->
    <uses-permission android:name="com.chronosbvrx.visionplus.permission.ENGINE_PREWARM" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Ver las apps instaladas sin pedir QUERY_ALL_PACKAGES: solo las que se pueden lanzar. -->
    <queries>
        <!-- Los otros Inicios del equipo: sin esto la app no puede saber quién abre la tele
             (Android 11+ oculta los paquetes que no se declaran) y reporta un launcher falso. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.chronosbvrx.visionplus" />
    </queries>

    <application
        android:name=".HomeApp"
        android:allowBackup="false"
        android:banner="@drawable/ic_home_banner"
        android:icon="@drawable/ic_home_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VisionHome"
        android:largeHeap="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.VisionHome">
            <!--
              El Inicio va en un filtro PROPIO (como los launchers de Google): mezclar HOME con
              LEANBACK_LAUNCHER/LAUNCHER hace que varios firmware no lo ofrezcan como Inicio.

              NO se declara `android:priority`: Android recorta a 0 cualquier prioridad >0 pedida
              por una app que no es privilegiada, así que el launcher de fábrica siempre gana ese
              desempate. La elección real se hace por rol (Android 10+) o en Ajustes.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Aparecer en la lista de apps de la tele y del teléfono (no como Inicio). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Instalador del propio launcher (la descarga vive en el cache de la app). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/home_update_paths" />
        </provider>
    </application>
</manifest>
