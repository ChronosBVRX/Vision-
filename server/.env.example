# Copia este archivo a .env y completa los valores. .env nunca se sube al repo.
# En el VPS: genera secretos reales con `openssl rand -hex 24`.
POSTGRES_DB=catalog_db
POSTGRES_USER=catalog_user
POSTGRES_PASSWORD=cambia-esta-contrasena
API_KEY=cambia-esta-clave

# Cada cuánto corre el ciclo de sync (segundos). 21600 = 6 h.
SYNC_INTERVAL_SECONDS=21600

# Conectores (1 = activo). XTV es el catálogo principal.
XTV_SYNC=1
MAGIS_SYNC=1
IA_SYNC=1

# Tope de páginas al bajar cada sección completa (0 = todas; Movies "All" son ~311).
XTV_MAX_PAGES=0
# Páginas por colección propia (HBO, Netflix, 2026, …) para categorías nativas.
XTV_COLLECTION_PAGES=3
# Pasada PROFUNDA de colecciones: páginas por colección (tope real del portal = 100,
# 10.000 títulos) y cada cuántas horas corre. Los listados topan en 10k y con 3
# páginas los clásicos quedaban fuera («Guerra de Papás» vive en Comedia página 73).
# 0 en las páginas = desactivada.
XTV_COLLECTION_DEEP_PAGES=100
XTV_DEEP_EVERY_HOURS=168
# Espacio libre mínimo (GB) del filesystem de Docker para arrancar la pasada profunda
# (en el VPS el Docker Root vive en un volumen de 15 GB: sin esto, un disco casi
# lleno dejó a Postgres sin WAL — crash-loop real del 2026-10-18).
XTV_DEEP_MIN_FREE_GB=2
# Profundidad extra solo en colecciones de series/anime/kids (0 = igual que arriba):
# el "All" de series trae ~21k y el tope por listado es 10k; las temporadas viejas
# viven en colecciones.
XTV_SERIES_COLLECTION_PAGES=15
# Ritmo entre páginas (segundos) para no martillar el portal.
XTV_PAGE_DELAY_SECONDS=0.15

# Agenda de fútbol (ESPN, sin clave): ciclo propio cada 10 min; no toca el índice.
SPORTS_SYNC=1
SPORTS_INTERVAL_SECONDS=600

# GeeSports V3.8 (deportes en vivo: fuente principal de Fútbol y eventos).
# Ciclo propio; la clave de su CMS es SECRETA y vive solo en el .env real
# (16 caracteres ASCII o 32 hex, derivada del APK V3.8 — ver credenciales).
GEE38_SYNC=1
GEE38_INTERVAL_SECONDS=2700
# GEE38_KEY=

# Enriquecimiento TMDB (sin clave, se omite). Lote por ciclo y ritmo.
TMDB_API_KEY=
ENRICH_BATCH=300
ENRICH_DELAY_SECONDS=0.25
# Nombres para buscar (es-MX/original/regionales) de matches ya hechos: lote por
# ciclo y ritmo propio (más rápido que el enriquecimiento: ya no busca, solo lee
# la ficha). El estreno puede correrse con `python tmdb.py --aliases 6` en el sync
# (6 = descargas en olas paralelas; subir TMDB_ALIAS_GAP_SECONDS a ~0.25 con eso).
TMDB_ALIAS_BATCH=1500
TMDB_ALIAS_GAP_SECONDS=0.08
# Títulos por ciclo cuyo texto de búsqueda se rehace (títulos nuevos/recién casados).
SEARCH_TEXT_BATCH=20000

# Identidad propia del worker ante el portal (hex de 32). Con su propio SN deja de
# pelear la sesión con las apps; vacío = se comporta como un aparato más.
# Generar una vez con: python3 -c "import secrets; print(secrets.token_hex(16))"
# XTV_SERVER_SN=

# Solo para pruebas locales: inserta títulos de ejemplo si la base está vacía.
# SEED_DEMO=1

# Salud del catálogo (avisa al Telegram): horas sin que el ciclo de sync refresque
# (normal 6 h) y días sin que corra la pasada profunda (normal 7), con enfriamiento
# para no repetir la alerta cada 5 minutos mientras siga caído.
# DIAG_CATALOG_STALE_HOURS=10
# DIAG_DEEP_STALE_DAYS=8
# DIAG_HEALTH_COOLDOWN_HOURS=12

TZ=America/Mexico_City

# Referencia para correr la API fuera de Docker (requiere mapear 5432 en local):
# DATABASE_URL=postgresql://catalog_user:cambia-esta-contrasena@localhost:5432/catalog_db
