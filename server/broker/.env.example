# Copia a .env y completa. Este archivo NUNCA va al repo ni al APK.
# La API key debe ser la misma del catálogo: la app la manda en X-Api-Key.
API_KEY=
CONFIG_ADMIN_KEY=

# Cuenta que firma. Se guarda solo aquí (servidor aislado).
VIP_SN=
VIP_USER_ID=
VIP_EMAIL=
VIP_PASSWORD_HASH=
# Alternativa si no usas el hash:
VIP_PASSWORD=
