<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="bool" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/core.brs" />
    <script type="text/brightscript" uri="pkg:/components/EpisodeCard.brs" />
    <children>
        <Poster id="cardBg" uri="pkg:/images/panel_episode.png" width="300" height="214" loadDisplayMode="scaleToFill" />
        <MaskGroup id="mask" width="300" height="150" maskUri="pkg:/images/mask_landscape.png" maskSize="[300,150]">
            <Poster id="still" width="300" height="150" loadDisplayMode="scaleToFill" />
        </MaskGroup>
        <Poster id="numBg" uri="pkg:/images/badge_dark.png" width="54" height="28" translation="[10,10]" loadDisplayMode="scaleToFill" />
        <Label id="number" width="54" height="28" translation="[10,10]" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" color="0xF5C518FF" />
        <Label id="title" width="280" height="52" translation="[10,158]" font="font:SmallBoldSystemFont" color="0xF4F7FCFF" wrap="true" ellipsisText="..." />
        <Poster id="focusBorder" uri="pkg:/images/focus_episode.png" width="308" height="222" translation="[-4,-4]" visible="false" />
    </children>
</component>
