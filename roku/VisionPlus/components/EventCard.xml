<?xml version="1.0" encoding="utf-8" ?>
<component name="EventCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="bool" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/core.brs" />
    <script type="text/brightscript" uri="pkg:/components/EventCard.brs" />
    <children>
        <Poster id="cardBg" uri="pkg:/images/panel_event.png" width="380" height="220" loadDisplayMode="scaleToFill" />
        <Poster id="logo" width="80" height="52" translation="[16,14]" loadDisplayMode="scaleToFit" />
        <Label id="badge" width="150" height="28" translation="[214,14]" horizAlign="right" font="font:SmallBoldSystemFont" color="0x7AD9A8FF" />
        <Label id="title" width="348" height="60" translation="[16,72]" font="font:SmallBoldSystemFont" color="0xF4F7FCFF" wrap="true" ellipsisText="..." />
        <Label id="subtitle" width="348" height="30" translation="[16,136]" font="font:SmallSystemFont" color="0x9BA8BDFF" ellipsisText="..." />
        <Label id="hint" width="348" height="24" translation="[16,176]" font="font:SmallSystemFont" color="0x6BA6FFFF" text="OK Ver opciones" />
        <Poster id="focusBorder" uri="pkg:/images/focus_event.png" width="388" height="228" translation="[-4,-4]" visible="false" />
    </children>
</component>
