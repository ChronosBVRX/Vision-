{
  "name": "vision-plus",
  "version": "1.0.47",
  "description": "Aplicación para ver películas y canales de TV en vivo con panel de administración y reproductor interno libre de anuncios.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && npm install --prefix frontend",
    "logs": "node read-logs.js",
    "errors": "node read-logs.js --errors",
    "sync": "node direct-sync.js",
    "server-sync": "node server-sync.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "input": "^1.0.1",
    "playwright": "^1.60.0",
    "puppeteer": "^25.1.0",
    "sqlite3": "^6.0.1",
    "telegram": "^2.26.22",
    "youtube-dl-exec": "^3.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
