<?xml version="1.0" encoding="utf-8"?>
<!--
  Las variantes de voz de Fiesta se resuelven por nombre con getIdentifier()
  (para no atar el APK a 100+ constantes R.raw). Sin este keep, el resource
  shrinker las elimina del APK release.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/fiesta_*" />
