<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

<!-- El feed que lee Vision+ Home (el launcher, APK aparte): nivel `signature`, así que solo
     un APK firmado con la misma llave histórica puede leerlo. -->
<permission
    android:name="com.chronosbvrx.visionplus.permission.HOME_FEED"
    android:protectionLevel="signature" />

<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
<!-- Control remoto por LAN: la tele escucha la difusión del teléfono y sostiene el multicast. -->
<uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
<uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
<!-- Canal Watch Next («Continuar viendo») del launcher de Android TV / Google TV. -->
<uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- The one source: Vision+ talks to the XuperPlugin app on the device for its catalog. -->
    <queries>
        <package android:name="com.xuper.plugin" />
        <!-- Vision+ Home (el launcher): instalado/versión y abrirlo desde Ajustes. -->
        <package android:name="com.chronosbvrx.visionplus.home" />
    </queries>

    <!-- Android TV: no touchscreen required, leanback optional so phones can install it too. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".VisionApp"
        android:allowBackup="false"
        android:banner="@drawable/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vision"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/ic_banner"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vision.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Tarjetas del launcher (canal Watch Next) y Vision+ Home: reanudan la
                 película/capítulo, abren una ficha y los hubs del sistema. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="visionplus" android:host="watch" />
                <!-- Control remoto / launcher: abre un canal en vivo. -->
                <data android:scheme="visionplus" android:host="live" />
                <!-- Vision+ Home: ficha de un título. -->
                <data android:scheme="visionplus" android:host="title" />
                <!-- Vision+ Home: ajustes, buscador, secciones e Inicio. -->
                <data android:scheme="visionplus" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Reproductor residente («Camino B»): tarea propia fuera de recientes, una sola
             instancia con su vista del motor reutilizada entre reproducciones; el proceso
             `:x4k` sobrevive a la salida para que el próximo play no arranque en frío. -->
        <activity
            android:name=".ui.player.X4KPlayerAty"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.chronosbvrx.visionplus.player"
            android:excludeFromRecents="true"
            android:process=":x4k" />

        <receiver
            android:name=".data.xuper.X4KWarmupReceiver"
            android:exported="false"
            android:process=":x4k" />

        <!-- Avisos locales (capítulos nuevos + partidos): alarma del sistema. -->
        <receiver
            android:name=".data.notify.ReminderReceiver"
            android:exported="false" />

        <!-- El usuario descartó una tarjeta de Vision+ en el launcher: se quita del canal. -->
        <receiver
            android:name=".data.launcher.WatchNextRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.ACTION_WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- Sirve los pósters cacheados de las tarjetas del launcher (solo lectura). -->
        <provider
            android:name=".data.launcher.LauncherArtProvider"
            android:authorities="${applicationId}.launcherart"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- El Inicio que pinta Vision+ Home: solo lectura y solo firma. -->
        <provider
            android:name=".data.homefeed.HomeFeedProvider"
            android:authorities="${applicationId}.homefeed"
            android:exported="true"
            android:readPermission="com.chronosbvrx.visionplus.permission.HOME_FEED"
            android:writePermission="com.chronosbvrx.visionplus.permission.HOME_FEED" />

        <service
            android:name=".data.offline.X4KDownloadService"
            android:exported="false"
            android:process=":x4k"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
